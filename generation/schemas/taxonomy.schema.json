{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lsatprep://taxonomy.schema.json",
  "type": "object",
  "required": ["version", "bankVersion", "sections"],
  "properties": {
    "version": { "type": "string" },
    "bankVersion": { "type": "string" },
    "sections": {
      "type": "object",
      "required": ["LR", "RC", "LG"],
      "properties": {
        "LR": {
          "type": "object",
          "required": ["name", "subtypes"],
          "properties": {
            "name": { "type": "string" },
            "subtypes": {
              "type": "object",
              "additionalProperties": { "$ref": "#/definitions/subtypeRubric" }
            }
          }
        },
        "RC": {
          "type": "object",
          "required": ["name", "genres", "questionTypes"],
          "properties": {
            "name": { "type": "string" },
            "genres": { "type": "object" },
            "questionTypes": { "type": "object" }
          }
        },
        "LG": {
          "type": "object",
          "required": ["name", "families"],
          "properties": {
            "name": { "type": "string" },
            "families": { "type": "object" }
          }
        }
      }
    }
  },
  "definitions": {
    "subtypeRubric": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "coverageTarget": { "type": "integer", "minimum": 0 },
        "difficultyAnchors": {
          "type": "object",
          "properties": {
            "1": { "type": "string" },
            "2": { "type": "string" },
            "3": { "type": "string" }
          }
        },
        "commonTraps": { "type": "array", "items": { "type": "string" } },
        "stemTemplates": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
