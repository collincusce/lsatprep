{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lsatprep://coverage-matrix.schema.json",
  "type": "object",
  "required": ["version", "totalTarget", "cells"],
  "properties": {
    "version": { "type": "string" },
    "totalTarget": { "type": "integer", "minimum": 1 },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["section", "count", "batchSize"],
        "properties": {
          "section": { "type": "string", "enum": ["LR", "RC", "LG"] },
          "subtype": { "type": "string" },
          "genre": { "type": "string" },
          "family": { "type": "string" },
          "difficulty": { "type": "integer", "enum": [1, 2, 3] },
          "count": { "type": "integer", "minimum": 0 },
          "batchSize": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
