# The Anthropic API key used by the Lambda. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Auto-generated by setup-aws.sh; used by Lambda + frontend for shared-secret auth.
SHARED_SECRET=

# Filled in by setup-aws.sh after Function URL is created.
LAMBDA_FUNCTION_URL=

# Your GitHub Pages origin. Used as Lambda CORS allow-origin.
ALLOWED_ORIGIN=https://collincusce.github.io

# Email that receives SNS alarm + Budget alerts.
ALARM_EMAIL=
